{
  "name": "spare-parts-forecasting-system",
  "version": "1.0.0",
  "description": "Full-stack spare parts forecasting application",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
